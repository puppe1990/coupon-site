{
  "name": "coupon-site",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.8.2",
    "react-scripts": "5.0.1",
    "tailwind-merge": "^2.5.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "serve": "node server/index.js",
    "dev:api": "node --watch server/index.js",
    "build": "react-scripts build",
    "seed": "node scripts/seed.js",
    "icons": "bash scripts/render-icons.sh",
    "og": "bash scripts/render-og.sh",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src server scripts --ext .js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "test:server": "node --test server/*.test.js server/routes/*.test.js",
    "check": "npm run lint && npm run format:check && npm run test:ci && npm run test:server",
    "prepare": "husky"
  },
  "proxy": "http://localhost:3001",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "server/**/*.js",
          "scripts/**/*.js"
        ],
        "env": {
          "node": true
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.14"
  }
}
